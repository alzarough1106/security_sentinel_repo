<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gdpr_report_wizard_form" model="ir.ui.view">
        <field name="name">gdpr.report.wizard.form</field>
        <field name="model">gdpr.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate GDPR Report">
                <group>
                    <field name="name"/>
                    <field name="report_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="subject_partner_id"
                           invisible="report_type != 'subject_access'"
                           required="report_type == 'subject_access'"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>Article 30 Report:</strong> Comprehensive record of all data processing activities for the period.<br/>
                    <strong>Subject Access Report:</strong> All data and access history for one specific individual (Article 15).
                </div>
                <footer>
                    <button name="action_generate" string="Generate PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gdpr_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate GDPR Report</field>
        <field name="res_model">gdpr.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>