<odoo>
    <record id="module_category_session_audit" model="ir.module.category">
        <field name="name">Session &amp; Audit</field>
    </record>

    <record id="group_session_audit_user" model="res.groups">
        <field name="name">Session &amp; Audit / User</field>
        <field name="category_id" ref="module_category_session_audit"/>
    </record>

    <record id="group_session_audit_manager" model="res.groups">
        <field name="name">Session &amp; Audit / Manager</field>
        <field name="category_id" ref="module_category_session_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_session_audit_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_own_session" model="ir.rule">
        <field name="name">Users: own sessions only</field>
        <field name="model_id" ref="model_res_users_session"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_session_audit_user'))]"/>
    </record>
    <record id="rule_all_session_manager" model="ir.rule">
        <field name="name">Managers: all sessions</field>
        <field name="model_id" ref="model_res_users_session"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_session_audit_manager'))]"/>
    </record>

    <record id="rule_own_audit_log" model="ir.rule">
        <field name="name">Users: own audit logs only</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_session_audit_user'))]"/>
    </record>
    <record id="rule_all_audit_log_manager" model="ir.rule">
        <field name="name">Managers: all audit logs</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_session_audit_manager'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_session_audit_user'))]"/>
    </record>
    <record id="rule_session_multi_company" model="ir.rule">
        <field name="name">Session: multi-company</field>
        <field name="model_id" ref="model_res_users_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_audit_log_multi_company" model="ir.rule">
        <field name="name">Audit Log: multi-company</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>