<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.super.session.audit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Session &amp; Audit"
                     name="super_session_audit"
                     data-string="Session &amp; Audit"
                     data-key="super_session_audit">

                    <block title="Session Management" name="session_timeout_setting_block">
                        <setting help="Sessions inactive longer than this are automatically killed.">
                            <field name="session_idle_timeout_minutes"/>
                        </setting>
                    </block>

                    <block title="Audit Log" name="audit_log_setting_block">
                        <setting help="Logs older than this are purged automatically (0 = keep forever).">
                            <field name="audit_log_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>