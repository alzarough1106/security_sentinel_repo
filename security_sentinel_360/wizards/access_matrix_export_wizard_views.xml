<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_access_matrix_export_wizard_form" model="ir.ui.view">
        <field name="name">audit.access.matrix.export.wizard.form</field>
        <field name="model">audit.access.matrix.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Access Matrix">
                <group attrs="{'invisible': [('state', '=', 'done')]}">
                    <group>
                        <field name="group_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="sensitive_only"/>
                        <field name="show_share_users"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('state', '=', 'draft')]}">
                    <field name="file_data" filename="file_name" readonly="1"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_export" string="Export to CSV" type="object"
                            class="btn-primary" attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
                <field name="state" invisible="1"/>
            </form>
        </field>
    </record>

    <record id="action_access_matrix_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Access Matrix</field>
        <field name="res_model">audit.access.matrix.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>