<odoo>
    <record id="view_user_session_search" model="ir.ui.view">
        <field name="name">res.users.session.search</field>
        <field name="model">res.users.session</field>
        <field name="arch" type="xml">
            <search string="Search Sessions">
                <field name="user_id" string="User"/>
                <field name="ip_address" string="IP Address"/>
                <field name="browser"/>
                <field name="operating_system" string="OS"/>
                <field name="session_token" string="Session ID"/>

                <filter string="My Sessions" name="my_sessions"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Active" name="state_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="state_closed"
                        domain="[('state', '=', 'closed')]"/>
                <filter string="Killed" name="state_killed"
                        domain="[('state', '=', 'killed')]"/>
                <separator/>
                <filter string="New Devices" name="new_device"
                        domain="[('is_new_device', '=', True)]"/>
                <filter string="Suspicious (New Device &amp; Active)" name="suspicious"
                        domain="[('is_new_device', '=', True), ('state', '=', 'active')]"/>
                <separator/>
                <filter string="Today" name="login_today"
                        domain="[('login_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Last 7 Days" name="login_7d"
                        domain="[('login_date', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Last 30 Days" name="login_30d"
                        domain="[('login_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]"/>

                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Device Type" name="group_device" context="{'group_by': 'device_type'}"/>
                    <filter string="Browser" name="group_browser" context="{'group_by': 'browser'}"/>
                    <filter string="Operating System" name="group_os" context="{'group_by': 'operating_system'}"/>
                    <separator/>
                    <filter string="Login Date (Day)" name="group_login_day"
                            context="{'group_by': 'login_date:day'}"/>
                    <filter string="Login Date (Week)" name="group_login_week"
                            context="{'group_by': 'login_date:week'}"/>
                    <filter string="Login Date (Month)" name="group_login_month"
                            context="{'group_by': 'login_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>