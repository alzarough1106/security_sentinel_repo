<odoo>
    <record id="view_audit_log_list" model="ir.ui.view">
        <field name="name">audit.log.list</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Performed Date"/>
                <field name="user_id"/>
                <field name="model_name" string="Model"/>
                <field name="record_name" string="Record Name"/>
                <field name="method" string="Action Performed"/>
                <field name="session_id"/>
            </list>
        </field>
    </record>

    <record id="view_audit_log_form" model="ir.ui.view">
        <field name="name">audit.log.form</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object"
                                class="oe_stat_button" icon="fa-external-link">
                            <span>Open Record</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="record_name" string="Record Name"/>
                            <field name="model_name" string="Model"/>
                            <field name="session_id" string="Session"/>
                        </group>
                        <group>
                            <field name="res_id" string="Record ID"/>
                            <field name="method" string="Action"/>
                            <field name="create_date" string="Performed Date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Changes">
                            <field name="changes_summary" nolabel="1"/>
                        </page>
                        <page string="Changes Views">
                            <field name="changes_detail" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_audit_log_kanban" model="ir.ui.view">
        <field name="name">audit.log.kanban</field>
        <field name="model">audit.log</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="method"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_audit_card border-start border-4
            #{record.method.raw_value == 'create' ? 'border-success' :
              record.method.raw_value == 'unlink' ? 'border-danger' :
              record.method.raw_value == 'write' ? 'border-info' : 'border-secondary'}">
                            <div class="d-flex justify-content-between">
                                <strong>
                                    <field name="record_name"/>
                                </strong>
                                <span t-attf-class="badge #{record.method.raw_value == 'create' ? 'bg-success' :
                    record.method.raw_value == 'unlink' ? 'bg-danger' :
                    record.method.raw_value == 'write' ? 'bg-info' : 'bg-secondary'}">
                                    <field name="method"/>
                                </span>
                            </div>
                            <div class="text-muted small">
                                <field name="model_name"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-user" title="User"/>
                                <field name="user_id"/>
                            </div>
                            <div class="small">
                                <field name="create_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">audit.log</field>
        <field name="view_mode">kanban,list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_audit_log_search"/>
        <field name="context">{
            'create': False, 'edit': False,
            'search_default_last_7d': 1,
            'search_default_group_model': 1
            }
        </field>
    </record>
</odoo>