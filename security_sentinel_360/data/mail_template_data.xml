<odoo>
    <record id="mail_template_new_session" model="mail.template">
        <field name="name">New Login Session Notification</field>
        <field name="model_id" ref="model_res_users_session"/>
        <field name="subject">New login detected on your account</field>
        <field name="email_to">{{ object.user_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.user_id.name"/>,</p>
                <p>A new login to your account was detected:</p>
                <ul>
                    <li>Date: <t t-out="object.login_date"/></li>
                    <li>IP Address: <t t-out="object.ip_address"/></li>
                    <li>Browser: <t t-out="object.browser"/> <t t-out="object.browser_version"/></li>
                    <li>Operating System: <t t-out="object.operating_system"/></li>
                    <li>Device: <t t-out="object.device_type"/></li>
                </ul>
                <p>If this wasn't you, kill this session immediately and change your password.</p>
            </div>
        </field>
    </record>
</odoo>